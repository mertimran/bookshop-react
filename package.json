{
  "name": "bookshop",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@cap-js/cds-types": "^0.16.0",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^6.0.0",
    "@cap-js/cds-typer": ">=0.1",
    "vite": "^8",
    "@vitejs/plugin-react": "^6",
    "@tanstack/router-plugin": "^1.167.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid",
    "dev:shop": "npm run dev --workspace=app/shop",
    "dev:admin": "npm run dev --workspace=app/admin",
    "build": "cds build --production && npm run build:srv",
    "build:srv": "tsc --project tsconfig.build.json",
    "build:shop": "npm run build --workspace=app/shop",
    "build:admin": "npm run build --workspace=app/admin",
    "build:hana": "cds build --for hana",
    "build:models": "cds build --for nodejs && npx @cap-js/cds-typer '*' --outputDirectory @cds-models",
    "build:mta": "mbt build",
    "build:clean": "rimraf gen mta_archives",
    "typecheck": "tsc --noEmit",
    "login": "cf login -a https://api.cf.eu20-001.hana.ondemand.com --sso",
    "deploy:hana": "cds deploy --to hana --profile hybrid",
    "deploy:hana:force": "HDI_DEPLOY_OPTIONS='{\"treat_unmodified_as_modified\":true,\"auto_undeploy\":true}' cds deploy --to hana --profile hybrid",
    "deploy": "cf deploy mta_archives/bookshop_1.0.0.mtar",
    "killport": "kill-port --port 4004"
  },
  "workspaces": [
    "app/shared",
    "app/shop",
    "app/admin"
  ],
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "app-front": true,
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "admin",
            "roles": [
              "admin"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      }
    }
  }
}
